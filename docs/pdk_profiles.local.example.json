        {"name": "metal4", "x_pitch": 0.72, "y_pitch": 0.72, "x_offset": 0.36, "y_offset": 0.36}
      ],
      "routing_bottom": "metal1", "routing_top": "metal4",
      "io_hor_layer": "metal3", "io_ver_layer": "metal2",
      "tapcell": "", "tap_distance": 0,
